# Copy to .env and adjust as needed. All of these are optional overrides of
# configs/config.yaml (see ml/utils/config.py::load_config).

# true|false — small subset/patch/batch/epochs for fast local iteration
DEV_MODE=true

# Path to your dataset root (paired clean/degraded layout, see docs/dataset.md).
# Defaults to the bundled synthetic placeholder dataset if unset.
DATASET_ROOT=data/synthetic

# auto|cpu|cuda
DEVICE=auto

# Frontend dev server -> backend URL (used only if you change the Vite proxy
# target away from the default http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000
